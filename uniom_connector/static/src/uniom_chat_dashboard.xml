<?xml version="1.0" encoding="UTF-8" ?>
<!-- Part of Uniom Messaging Gateway for Odoo. See LICENSE file for full
     copyright and licensing details. -->
<templates xml:space="preserve">

<t t-name="uniom_connector.ChatDashboard">
    <div class="o_uniom_chat d-flex">
        <aside class="o_uniom_sidebar d-flex flex-column" t-att-aria-label="this.labels.conversations">
            <div class="o_uniom_sidebar_head">
                <div class="o_uniom_sidebar_title">
                    <span class="o_uniom_sidebar_title_text" t-out="this.labels.conversations"/>
                    <span t-if="this.state.totalUnread" class="badge o_uniom_total_unread"
                          t-out="this.formatUnread(this.state.totalUnread)"
                          t-att-title="this.labels.unread"/>
                </div>
                <div class="o_uniom_sidebar_actions">
                    <button type="button" class="btn btn-sm o_uniom_icon_btn o_uniom_refresh"
                            t-on-click="this.refresh" t-att-disabled="this.state.refreshing"
                            t-att-title="this.labels.refresh" t-att-aria-label="this.labels.refresh">
                        <i class="oi" t-att-class="this.state.refreshing ? 'oi-spin' : ''" t-att-data-icon="this.state.refreshing ? 'progress_activity' : 'refresh'"
                           aria-hidden="true"/>
                    </button>
                    <button type="button" class="btn btn-sm o_uniom_icon_btn o_uniom_new_chat"
                            t-on-click="this.openNewChat" t-att-title="this.labels.newChat"
                            t-att-aria-label="this.labels.newChat">
                        <i class="oi" data-icon="add" aria-hidden="true"/>
                    </button>
                    <button type="button" class="btn btn-sm o_uniom_icon_btn o_uniom_manage"
                            t-on-click="this.openManage" t-att-title="this.labels.manage"
                            t-att-aria-label="this.labels.manage">
                        <i class="oi" data-icon="settings" aria-hidden="true"/>
                    </button>
                </div>
            </div>

            <div class="o_uniom_sidebar_filters">
                <div class="o_uniom_search">
                    <i class="oi o_uniom_search_icon" data-icon="search" aria-hidden="true"/>
                    <input type="search" class="o_uniom_search_input"
                           t-att-placeholder="this.labels.searchPlaceholder"
                           t-att-aria-label="this.labels.searchPlaceholder"
                           t-on-input="this.onSearchInput"/>
                </div>
                <div class="o_uniom_tabs" role="tablist" t-att-aria-label="this.labels.all">
                    <button type="button" role="tab" class="o_uniom_tab"
                            t-att-class="{ active: this.state.filter === 'all' }"
                            t-att-aria-selected="this.state.filter === 'all'"
                            t-on-click="() => this.setFilter('all')"
                            t-out="this.labels.all"/>
                    <button type="button" role="tab" class="o_uniom_tab"
                            t-att-class="{ active: this.state.filter === 'unread' }"
                            t-att-aria-selected="this.state.filter === 'unread'"
                            t-on-click="() => this.setFilter('unread')"
                            t-out="this.labels.unread"/>
                    <button type="button" role="tab" class="o_uniom_tab"
                            t-att-class="{ active: this.state.filter === 'failed' }"
                            t-att-aria-selected="this.state.filter === 'failed'"
                            t-on-click="() => this.setFilter('failed')"
                            t-out="this.labels.failed"/>
                </div>
                <select class="o_uniom_conn_select" t-on-change="this.onConnectionChange"
                        t-att-aria-label="this.labels.allConnections">
                    <option value="" t-att-selected="!this.state.connectionId" t-out="this.labels.allConnections"/>
                    <t t-foreach="this.connectionOptions" t-as="connection" t-key="connection.id">
                        <option t-att-value="connection.id"
                                t-att-selected="connection.id === this.state.connectionId"
                                t-out="this.connectionOptionLabel(connection)"/>
                    </t>
                </select>
            </div>

            <div class="o_uniom_chat_list flex-grow-1">
                <t t-if="this.state.loadingChats &amp;&amp; !this.state.chats.length">
                    <div class="o_uniom_skeleton_list" t-att-aria-label="this.labels.loading">
                        <div t-foreach="[1, 2, 3, 4, 5, 6]" t-as="row" t-key="row"
                             class="o_uniom_chat_item o_uniom_skeleton_row d-flex" aria-hidden="true">
                            <span class="o_uniom_avatar o_uniom_skeleton_avatar"/>
                            <div class="flex-grow-1 o_uniom_chat_meta">
                                <span class="o_uniom_skeleton_line o_uniom_skeleton_line_wide"/>
                                <span class="o_uniom_skeleton_line"/>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-elif="!this.state.chats.length">
                    <div class="o_uniom_empty o_uniom_empty_list">
                        <i class="oi oi-2x o_uniom_empty_icon" data-icon="forum" aria-hidden="true"/>
                        <t t-if="this.state.search || this.state.filter !== 'all' || this.state.connectionId">
                            <p class="o_uniom_empty_title" t-out="this.labels.emptyFiltered"/>
                        </t>
                        <t t-else="">
                            <p class="o_uniom_empty_title" t-out="this.labels.emptyTitle"/>
                            <p class="o_uniom_empty_hint" t-out="this.labels.emptyHint"/>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <t t-foreach="this.state.chats" t-as="chat" t-key="chat.id">
                        <div class="o_uniom_chat_item d-flex"
                             t-att-class="{ o_active: chat.id === this.state.activeId, o_unread: chat.unread_count > 0 }"
                             t-on-click="() => this.openChat(chat.id)"
                             t-on-keydown="(ev) => this.onChatKeydown(ev, chat.id)"
                             role="button" tabindex="0"
                             t-att-aria-label="chat.display_name"
                             t-att-aria-current="chat.id === this.state.activeId">
                            <t t-if="this.chatAvatarUrl(chat) &amp;&amp; !this.state.brokenAvatars.includes(chat.id)">
                                <img class="o_uniom_avatar" t-att-src="this.chatAvatarUrl(chat)"
                                     t-att-alt="chat.display_name"
                                     t-on-error="() => this.onAvatarError(chat.id)"/>
                            </t>
                            <t t-else="">
                                <span class="o_uniom_avatar o_uniom_avatar_initials"
                                      t-att-style="this.chatAvatarStyle(chat)">
                                    <t t-if="this.chatInitials(chat)" t-out="this.chatInitials(chat)"/>
                                    <i t-else="" class="oi" data-icon="forum" aria-hidden="true"/>
                                </span>
                            </t>
                            <div class="flex-grow-1 o_uniom_chat_meta">
                                <div class="o_uniom_chat_name_row">
                                    <span class="o_uniom_chat_name" t-out="chat.display_name"/>
                                    <span class="o_uniom_chat_time"
                                          t-out="this.relativeTime(chat.last_message_date)"
                                          t-att-title="chat.last_message_date || ''"/>
                                </div>
                                <div class="o_uniom_chat_preview_row">
                                    <span class="o_uniom_chat_preview">
                                        <i t-if="this.lastKindIcon(chat)"
                                           class="oi o_uniom_preview_icon" t-att-data-icon="this.lastKindIcon(chat)"
                                           role="img" t-att-aria-label="this.lastKindLabel(chat)"/>
                                        <span t-if="this.lastDirectionIsOut(chat)" class="o_uniom_preview_tick"
                                              t-att-title="this.labels.sent">
                                            <i class="oi" data-icon="check" aria-hidden="true"/>
                                            <i class="oi" data-icon="check" aria-hidden="true"/>
                                        </span>
                                        <span class="o_uniom_preview_text"
                                              t-out="chat.last_message_preview || chat.chat_id"/>
                                    </span>
                                    <span t-if="chat.unread_count" class="o_uniom_chat_count"
                                          t-out="this.formatUnread(chat.unread_count)"/>
                                    <i t-if="this.isChatFailed(chat)"
                                       class="oi o_uniom_chat_failed" data-icon="warning"
                                       role="img" t-att-aria-label="this.labels.failedBadge"
                                       t-att-title="this.labels.failedBadge"/>
                                </div>
                                <div class="o_uniom_conn">
                                    <t t-if="this.platformIconUrl(this.connectionPlatformKey(chat))">
                                        <img class="o_uniom_conn_icon"
                                             t-att-src="this.platformIconUrl(this.connectionPlatformKey(chat))"
                                             alt="" aria-hidden="true"
                                             t-att-title="this.connectionName(chat)"/>
                                    </t>
                                    <span t-else="" class="o_uniom_conn_dot"
                                          t-att-style="this.connectionStyle(chat)"/>
                                    <span class="o_uniom_conn_label"
                                          t-out="this.connectionPlatform(chat)"
                                          t-att-title="this.connectionName(chat)"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </div>
        </aside>

        <main class="o_uniom_main d-flex flex-column flex-grow-1">
            <t t-if="this.state.activeChat">
                <header class="o_uniom_thread_head">
                    <div class="o_uniom_thread_identity">
                        <t t-if="this.chatAvatarUrl(this.state.activeChat) &amp;&amp; !this.state.brokenAvatars.includes(this.state.activeChat.id)">
                            <img class="o_uniom_avatar o_uniom_avatar_lg"
                                 t-att-src="this.chatAvatarUrl(this.state.activeChat)"
                                 t-att-alt="this.state.activeChat.display_name"
                                 t-on-error="() => this.onAvatarError(this.state.activeChat.id)"/>
                        </t>
                        <t t-else="">
                            <span class="o_uniom_avatar o_uniom_avatar_lg o_uniom_avatar_initials"
                                  t-att-style="this.chatAvatarStyle(this.state.activeChat)">
                                <t t-if="this.chatInitials(this.state.activeChat)" t-out="this.chatInitials(this.state.activeChat)"/>
                                <i t-else="" class="oi" data-icon="forum" aria-hidden="true"/>
                            </span>
                        </t>
                        <div class="o_uniom_thread_meta">
                            <div class="o_uniom_thread_title" t-out="this.state.activeChat.display_name"/>
                            <div class="o_uniom_thread_sub">
                                <span t-att-class="'o_uniom_presence ' + this.presenceClass(this.state.activeChat)"
                                      t-att-title="this.presenceTooltip(this.state.activeChat)">
                                    <i class="oi o_uniom_presence_dot" data-icon="circle" aria-hidden="true"/>
                                    <span t-out="this.presenceText(this.state.activeChat)"/>
                                </span>
                                <span class="o_uniom_thread_sep" aria-hidden="true">·</span>
                                <span class="o_uniom_thread_chatid" t-out="this.state.activeChat.chat_id"/>
                                <span t-if="this.state.activeChat.messenger_username" class="o_uniom_thread_username"
                                      t-out="'@' + this.state.activeChat.messenger_username"/>
                                <span t-if="this.connectionPlatform(this.state.activeChat)" class="o_uniom_platform_badge"
                                      t-att-title="this.connectionName(this.state.activeChat)">
                                    <img t-if="this.platformIconUrl(this.connectionPlatformKey(this.state.activeChat))"
                                         class="o_uniom_platform_badge_icon"
                                         t-att-src="this.platformIconUrl(this.connectionPlatformKey(this.state.activeChat))"
                                         alt="" aria-hidden="true"/>
                                    <span t-out="this.connectionPlatform(this.state.activeChat)"/>
                                </span>
                                <span t-if="this.chatTypeLabel(this.state.activeChat)" class="o_uniom_chat_type_badge"
                                      t-out="this.chatTypeLabel(this.state.activeChat)"/>
                            </div>
                        </div>
                    </div>
                    <div class="o_uniom_thread_actions">
                        <button type="button" class="btn btn-sm btn-light o_uniom_icon_btn o_uniom_load_older_btn"
                                t-on-click="this.loadOlder"
                                t-att-disabled="!this.state.hasMoreHistory || this.state.loadingOlder || this.state.loadingMessages"
                                t-att-title="this.labels.loadOlder" t-att-aria-label="this.labels.loadOlder">
                            <i class="oi" t-att-class="this.state.loadingOlder ? 'oi-spin' : ''" t-att-data-icon="this.state.loadingOlder ? 'progress_activity' : 'history'"
                               aria-hidden="true"/>
                        </button>
                        <button type="button" class="btn btn-sm btn-light o_uniom_icon_btn o_uniom_open_partner"
                                t-on-click="this.openPartner" t-att-title="this.labels.openPartner"
                                t-att-aria-label="this.labels.openPartner">
                            <i class="oi" data-icon="person" aria-hidden="true"/>
                        </button>
                        <button type="button" class="btn btn-sm btn-light o_uniom_icon_btn o_uniom_thread_refresh"
                                t-on-click="this.refreshThread"
                                t-att-disabled="this.state.refreshing"
                                t-att-title="this.labels.refresh" t-att-aria-label="this.labels.refresh">
                            <i class="oi" t-att-class="this.state.refreshing ? 'oi-spin' : ''" t-att-data-icon="this.state.refreshing ? 'progress_activity' : 'refresh'"
                               aria-hidden="true"/>
                        </button>
                        <button type="button" class="btn btn-sm btn-light o_uniom_icon_btn o_uniom_sync_presence"
                                t-on-click="this.syncPresence"
                                t-att-disabled="this.state.syncingPresence"
                                t-att-title="this.labels.syncPresence" t-att-aria-label="this.labels.syncPresence">
                            <i class="oi" t-att-class="this.state.syncingPresence ? 'oi-spin' : ''" t-att-data-icon="this.state.syncingPresence ? 'progress_activity' : 'smartphone'"
                               aria-hidden="true"/>
                        </button>
                    </div>
                </header>

                <div class="o_uniom_thread flex-grow-1" t-ref="this.threadRef" role="log"
                     t-att-aria-label="this.state.activeChat.display_name">
                    <div class="o_uniom_thread_top">
                        <button t-if="this.state.hasMoreHistory" type="button"
                                class="btn btn-sm o_uniom_load_older"
                                t-on-click="this.loadOlder" t-att-disabled="this.state.loadingOlder">
                            <i class="oi" t-att-class="this.state.loadingOlder ? 'oi-spin' : ''" t-att-data-icon="this.state.loadingOlder ? 'progress_activity' : 'history'"
                               aria-hidden="true"/>
                            <span t-out="this.labels.loadOlder"/>
                        </button>
                    </div>

                    <t t-if="this.state.loadingMessages &amp;&amp; !this.state.messages.length">
                        <div class="o_uniom_skeleton_thread" role="status" t-att-aria-label="this.labels.loading">
                            <div t-foreach="[1, 2, 3]" t-as="row" t-key="row"
                                 t-att-class="'o_uniom_bubble_row ' + (row % 2 ? 'in' : 'out')"
                                 aria-hidden="true">
                                <div t-att-class="'o_uniom_bubble ' + (row % 2 ? 'in' : 'out')">
                                    <span class="o_uniom_skeleton_line o_uniom_skeleton_line_wide"/>
                                    <span class="o_uniom_skeleton_line"/>
                                </div>
                            </div>
                        </div>
                    </t>

                    <t t-elif="!this.state.messages.length">
                        <div class="o_uniom_empty o_uniom_empty_thread">
                            <i class="oi oi-2x o_uniom_empty_icon" data-icon="chat_bubble" aria-hidden="true"/>
                            <p class="o_uniom_empty_title" t-out="this.labels.noMessages"/>
                        </div>
                    </t>

                    <t t-else="">
                        <t t-foreach="this.state.messages" t-as="msg" t-key="msg.id">
                            <div t-if="msg.showDay" class="o_uniom_day">
                                <span class="o_uniom_day_label" t-out="msg.dayLabel"/>
                            </div>
                            <div t-att-class="'o_uniom_bubble_row ' + this.bubbleSide(msg.direction)">
                                <div t-att-class="'o_uniom_bubble ' + (msg.direction === 'in' ? 'in' : 'out') + (msg.optimistic ? ' o_uniom_bubble_pending' : '')">
                                    <div class="o_uniom_bubble_body" dir="auto">
                                        <div t-if="msg.attachments.length" class="o_uniom_attachments">
                                            <t t-foreach="msg.attachments" t-as="att" t-key="att.id">
                                                <a t-if="att.isImage" class="o_uniom_photo_link"
                                                   t-att-href="att.contentUrl" target="_blank"
                                                   rel="noopener noreferrer"
                                                   t-att-title="att.name">
                                                    <img class="o_uniom_photo" t-att-src="att.contentUrl"
                                                         t-att-alt="att.name"/>
                                                </a>
                                                <audio t-elif="att.isAudio" class="o_uniom_audio"
                                                       controls="controls" preload="metadata"
                                                       t-att-src="att.contentUrl"/>
                                                <video t-elif="att.isVideo" class="o_uniom_video"
                                                       controls="controls" preload="metadata"
                                                       t-att-src="att.contentUrl"/>
                                                <a t-else="" class="o_uniom_file" t-att-href="att.downloadUrl"
                                                   target="_blank" rel="noopener noreferrer"
                                                   t-att-title="att.name">
                                                    <span class="o_uniom_file_icon">
                                                        <i class="oi" data-icon="description" aria-hidden="true"/>
                                                    </span>
                                                    <span class="o_uniom_file_meta">
                                                        <span class="o_uniom_file_name" t-out="att.name"/>
                                                        <span t-if="att.sizeLabel" class="o_uniom_file_size"
                                                              t-out="att.sizeLabel"/>
                                                    </span>
                                                    <i class="oi o_uniom_file_download" data-icon="download"
                                                       aria-hidden="true"/>
                                                </a>
                                            </t>
                                        </div>

                                        <t t-if="msg.extra &amp;&amp; msg.extra.type === 'location'">
                                            <a class="o_uniom_card" t-att-href="msg.extra.url"
                                               target="_blank" rel="noopener noreferrer">
                                                <span class="o_uniom_card_icon">
                                                    <i class="oi" data-icon="location_on" aria-hidden="true"/>
                                                </span>
                                                <span class="o_uniom_card_body">
                                                    <span class="o_uniom_card_title" t-out="this.labels.location"/>
                                                    <span class="o_uniom_card_text"
                                                          t-out="msg.extra.latitude + ', ' + msg.extra.longitude"/>
                                                </span>
                                            </a>
                                        </t>
                                        <t t-elif="msg.extra &amp;&amp; msg.extra.type === 'contact'">
                                            <div class="o_uniom_card">
                                                <span class="o_uniom_card_icon">
                                                    <i class="oi" data-icon="person" aria-hidden="true"/>
                                                </span>
                                                <span class="o_uniom_card_body">
                                                    <span class="o_uniom_card_title"
                                                          t-out="msg.extra.name || this.labels.contact"/>
                                                    <a t-if="msg.extra.phoneUrl" class="o_uniom_card_text"
                                                       t-att-href="msg.extra.phoneUrl"
                                                       t-out="msg.extra.phone"/>
                                                </span>
                                            </div>
                                        </t>
                                        <t t-elif="msg.extra &amp;&amp; msg.extra.type === 'poll'">
                                            <div class="o_uniom_card o_uniom_card_poll">
                                                <span class="o_uniom_card_title" t-out="msg.extra.question"/>
                                                <ul t-if="msg.extra.options.length" class="o_uniom_poll_options">
                                                    <li t-foreach="msg.extra.options" t-as="option"
                                                        t-key="option_index" t-out="option"/>
                                                </ul>
                                            </div>
                                        </t>
                                        <t t-if="msg.showBody">
                                            <span class="o_uniom_text" t-out="msg.body"/>
                                        </t>
                                    </div>

                                    <div class="o_uniom_bubble_meta">
                                        <span t-if="msg.date_edited or msg.edit_count" class="o_uniom_edited"
                                              t-att-title="this.labels.edited" t-out="this.labels.edited"/>
                                        <span class="o_uniom_time" t-out="msg.timeLabel"/>
                                        <t t-if="msg.direction === 'out'">
                                            <t t-if="msg.optimistic">
                                                <i class="oi oi-spin o_uniom_tick o_queued" data-icon="progress_activity"
                                                   role="img" t-att-aria-label="this.labels.sending"/>
                                            </t>
                                            <t t-elif="msg.state === 'sent'">
                                                <span t-att-class="'o_uniom_ticks ' + (msg.seen_state === 'read' or msg.seen_state === 'seen' ? 'o_read' : 'o_sent')"
                                                      t-att-title="this.seenTitle(msg)"
                                                      t-att-aria-label="this.seenTitle(msg)" role="img">
                                                    <i class="oi" data-icon="check" aria-hidden="true"/>
                                                    <i class="oi" data-icon="check" aria-hidden="true"/>
                                                </span>
                                            </t>
                                            <t t-elif="msg.state === 'error'">
                                                <i class="oi o_uniom_tick o_failed" data-icon="warning"
                                                   role="img" t-att-aria-label="this.labels.failedMessage"
                                                   t-att-title="msg.error_message || this.labels.failedMessage"/>
                                            </t>
                                            <t t-elif="msg.state === 'canceled'">
                                                <i class="oi o_uniom_tick o_canceled" data-icon="block" role="img"
                                                   t-att-aria-label="this.labels.canceled"
                                                   t-att-title="this.labels.canceled"/>
                                            </t>
                                            <t t-else="">
                                                <i class="oi o_uniom_tick o_queued" data-icon="check" role="img"
                                                   t-att-aria-label="this.labels.queued"
                                                   t-att-title="msg.error_message || this.labels.queued"/>
                                            </t>
                                        </t>
                                    </div>

                                    <div t-if="msg.direction === 'out' &amp;&amp; msg.state === 'error' &amp;&amp; !msg.optimistic"
                                         class="o_uniom_bubble_actions">
                                        <button type="button" class="btn btn-sm btn-link o_uniom_retry"
                                                t-on-click="() => this.retryMessage(msg)">
                                            <i class="oi" data-icon="refresh" aria-hidden="true"/>
                                            <span t-out="this.labels.retry"/>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-link text-muted o_uniom_cancel"
                                                t-on-click="() => this.cancelMessage(msg)">
                                            <i class="oi" data-icon="block" aria-hidden="true"/>
                                            <span t-out="this.labels.cancel"/>
                                        </button>
                                    </div>
                                    <div t-if="msg.direction === 'out' &amp;&amp; msg.state === 'sent' &amp;&amp; !msg.optimistic &amp;&amp; !msg.deleted_on_messenger"
                                         class="o_uniom_bubble_actions">
                                        <button t-if="msg.message_kind === 'text'" type="button" class="btn btn-sm btn-link o_uniom_edit"
                                                t-on-click="() => this.editMessage(msg)">
                                            <i class="oi" data-icon="edit" aria-hidden="true"/>
                                            <span t-out="this.labels.edit"/>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-link text-muted o_uniom_delete"
                                                t-on-click="() => this.deleteMessage(msg)">
                                            <i class="oi" data-icon="delete" aria-hidden="true"/>
                                            <span t-out="this.labels.delete"/>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>

                <footer class="o_uniom_composer d-flex">
                    <input type="file" class="d-none" t-ref="this.fileInputRef"
                           t-on-change="this.onFilePicked" t-att-aria-label="this.labels.attach"/>
                    <button type="button" class="btn btn-light o_uniom_composer_attach"
                            t-on-click="this.openFilePicker" t-att-disabled="this.state.uploading"
                            t-att-title="this.state.uploading ? this.labels.uploading : this.labels.attach"
                            t-att-aria-label="this.state.uploading ? this.labels.uploading : this.labels.attach">
                        <i class="oi" t-att-class="this.state.uploading ? 'oi-spin' : ''" t-att-data-icon="this.state.uploading ? 'progress_activity' : 'attach_file'"
                           aria-hidden="true"/>
                    </button>
                    <textarea class="o_uniom_composer_input flex-grow-1" rows="1" t-ref="this.composerRef"
                              t-att-placeholder="this.labels.composerPlaceholder"
                              t-att-aria-label="this.labels.composerPlaceholder"
                              t-on-input="this.onComposerInput"
                              t-on-keydown="this.onComposerKeydown"/>
                    <button type="button" class="btn btn-primary o_uniom_composer_send"
                            t-on-click="this.sendReply" t-att-disabled="this.state.sending || this.state.uploading"
                            t-att-title="this.labels.send" t-att-aria-label="this.labels.send">
                        <i class="oi" t-att-class="this.state.sending ? 'oi-spin' : ''" t-att-data-icon="this.state.sending ? 'progress_activity' : 'send'"
                           aria-hidden="true"/>
                    </button>
                </footer>
            </t>
            <t t-else="">
                <div class="o_uniom_placeholder flex-grow-1 d-flex flex-column align-items-center justify-content-center text-muted">
                    <i class="oi oi-2x o_uniom_placeholder_icon" data-icon="forum" aria-hidden="true"/>
                    <p class="mb-0" t-out="this.labels.selectChat"/>
                </div>
            </t>
        </main>
    </div>
</t>

</templates>
