<?xml version="1.0" encoding="utf-8" ?>
<!-- Part of Uniom Messaging Gateway for Odoo. See LICENSE file for full
     copyright and licensing details. -->
<odoo>
    <record id="res_config_settings_view_form_uniom" model="ir.ui.view">
        <field name="name">res.config.settings.form.uniom</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="Uniom Messaging Gateway" name="uniom_connector_settings">
                    <setting id="uniom_enable" string="Uniom Notifications"
                             help="Master switch for all automated Uniom messages.">
                        <field name="uniom_enabled"/>
                    </setting>
                    <setting id="uniom_gateway" string="Gateway URL"
                             help="Default Uniom Bot API URL used by new connections.">
                        <field name="uniom_default_base_url"/>
                    </setting>
                    <setting id="uniom_outgoing_side" string="Own Messages Side"
                             help="Right (WhatsApp style) or left for your outgoing bubbles; incoming takes the other side.">
                        <field name="uniom_outgoing_side" widget="radio"/>
                    </setting>
                    <setting id="uniom_open_connections" string="Connections"
                             help="Manage API-key connections and register the inbound webhook.">
                        <button name="%(uniom_connector.action_uniom_connection)d" type="action" string="Open Connections" class="btn-secondary o_form_uri" icon="fa-arrow-right"/>
                    </setting>
                    <setting id="uniom_connect_account" string="Connect Account"
                             help="Add a messenger account with one API key — like logging in."
                             groups="uniom_connector.group_uniom_manager">
                        <button name="%(uniom_connector.action_uniom_setup_wizard)d" type="action" string="Connect Uniom Account" class="btn-primary o_form_uri" icon="fa-plug"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
