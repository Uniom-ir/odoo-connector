<?xml version="1.0" encoding="utf-8" ?>
<!-- Part of Uniom Messaging Gateway for Odoo. See LICENSE file for full
     copyright and licensing details. -->
<odoo>
    <record id="module_category_uniom" model="ir.module.category">
        <field name="name">Uniom</field>
        <field name="sequence">25</field>
    </record>

    <!-- Odoo 20 groups are grouped by a res.groups.privilege (the old
         res.groups.category_id was replaced by privilege_id). -->
    <record id="res_groups_privilege_uniom" model="res.groups.privilege">
        <field name="name">Uniom</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_uniom"/>
    </record>

    <record id="group_uniom_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_uniom"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can send Uniom messages and read the message log.</field>
    </record>

    <record id="group_uniom_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_uniom"/>
        <field name="implied_ids" eval="[(4, ref('group_uniom_user'))]"/>
        <field name="comment">Manages connections, API keys, automation rules and templates.</field>
    </record>

    <!-- Model permissions and multi-company rules live in ir.access.csv
         (Odoo 20 merged ir.model.access and ir.rule into ir.access). -->
</odoo>
