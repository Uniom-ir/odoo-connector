<?xml version="1.0" encoding="utf-8" ?>
<!-- Part of Uniom Messaging Gateway for Odoo. See LICENSE file for full
     copyright and licensing details. -->
<odoo>
    <record id="group_uniom_user" model="res.groups">
        <field name="name">User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can send Uniom messages and read the message log.</field>
    </record>

    <record id="group_uniom_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_uniom_user'))]"/>
        <field name="comment">Manages connections, API keys, automation rules and templates.</field>
    </record>

    <!-- Odoo 19 no longer auto-assigns new-app groups to the admin, so
         system administrators explicitly inherit Uniom management. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_uniom_manager'))]"/>
    </record>

    <!-- Multi-company rules: users only see data of their current companies. -->
    <record id="uniom_connection_company_rule" model="ir.rule">
        <field name="name">Uniom connection: multi-company</field>
        <field name="model_id" ref="model_uniom_connection"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="uniom_message_company_rule" model="ir.rule">
        <field name="name">Uniom message: multi-company</field>
        <field name="model_id" ref="model_uniom_message"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="uniom_rule_company_rule" model="ir.rule">
        <field name="name">Uniom rule: multi-company</field>
        <field name="model_id" ref="model_uniom_rule"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="uniom_chat_company_rule" model="ir.rule">
        <field name="name">Uniom chat: multi-company</field>
        <field name="model_id" ref="model_uniom_chat"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="uniom_template_company_rule" model="ir.rule">
        <field name="name">Uniom template: multi-company</field>
        <field name="model_id" ref="model_uniom_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
