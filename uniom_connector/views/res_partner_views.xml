<?xml version="1.0" encoding="utf-8" ?>
<!-- Part of Uniom Messaging Gateway for Odoo. See LICENSE file for full
     copyright and licensing details. -->
<odoo>
    <record id="view_partner_form_uniom" model="ir.ui.view">
        <field name="name">res.partner.form.uniom</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_uniom_send" type="object" class="oe_stat_button" icon="fa-send-o"
                        groups="uniom_connector.group_uniom_user">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Uniom</span>
                        <span class="o_stat_text">Send</span>
                    </div>
                </button>
                <button name="action_view_uniom_messages" type="object" class="oe_stat_button" icon="fa-comments-o"
                        groups="uniom_connector.group_uniom_user" invisible="uniom_chat_count == 0">
                    <field name="uniom_chat_count" widget="statinfo" string="Uniom Conversations"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="inside">
                <group string="Uniom Messaging" name="uniom" groups="uniom_connector.group_uniom_user">
                    <field name="uniom_chat_id"/>
                    <field name="uniom_opt_out"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
