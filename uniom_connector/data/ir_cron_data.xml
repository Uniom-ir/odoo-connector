<?xml version="1.0" encoding="utf-8" ?>
<!-- Part of Uniom Messaging Gateway for Odoo. See LICENSE file for full
     copyright and licensing details. -->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_uniom_process_queue" model="ir.cron">
            <field name="name">Uniom: process message queue</field>
            <field name="model_id" ref="model_uniom_message"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_queue()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_uniom_poll_updates" model="ir.cron">
            <field name="name">Uniom: poll inbound updates</field>
            <field name="model_id" ref="model_uniom_connection"/>
            <field name="state">code</field>
            <field name="code">model._cron_poll_updates()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_uniom_sync_presence" model="ir.cron">
            <field name="name">Uniom: sync chat presence</field>
            <field name="model_id" ref="model_uniom_connection"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_presence()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
