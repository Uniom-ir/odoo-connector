<?xml version="1.0" encoding="utf-8" ?>
<!-- Part of Uniom Messaging Gateway for Odoo. See LICENSE file for full
     copyright and licensing details. -->
<odoo>
    <record id="view_uniom_chat_kanban" model="ir.ui.view">
        <field name="name">uniom.chat.kanban</field>
        <field name="model">uniom.chat</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_order="last_message_date desc">
                <field name="display_name"/>
                <field name="chat_id"/>
                <field name="partner_id"/>
                <field name="connection_id"/>
                <field name="last_message_preview"/>
                <field name="last_message_date"/>
                <field name="message_count"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_card d-flex flex-column gap-1 p-2">
                        <div class="d-flex align-items-center gap-2">
                            <t t-if="record.partner_id.raw_value">
                                <img t-att-src="'/web/image/res.partner/' + record.partner_id.raw_value + '/image_128/56x56'"
                                     t-att-alt="record.display_name.value" class="o_kanban_avatar"
                                     style="width: 34px; height: 34px; border-radius: 50%;"/>
                            </t>
                            <t t-else="">
                                <i class="fa fa-user-circle fa-2x text-muted" role="img" t-att-aria-label="record.display_name.value"/>
                            </t>
                                <div class="flex-grow-1 overflow-hidden">
                                    <strong class="text-truncate d-block"><field name="display_name"/></strong>
                                    <small class="text-muted text-truncate d-block"><field name="chat_id"/></small>
                                </div>
                            </div>
                            <div class="text-truncate small"><field name="last_message_preview"/></div>
                            <div class="d-flex justify-content-between align-items-center text-muted" style="font-size: 0.8rem;">
                                <span class="badge text-bg-light"><field name="connection_id"/></span>
                                <span><field name="message_count"/> <i class="fa fa-comment-o" role="img" aria-label="Messages"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_uniom_chat_form" model="ir.ui.view">
        <field name="name">uniom.chat.form</field>
        <field name="model">uniom.chat</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_partner" type="object" string="Open Contact" icon="fa-user" class="oe_stat_button" invisible="not partner_id"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="display_name"/></h1>
                        <p class="oe_text_muted"><field name="chat_id"/></p>
                    </div>
                    <group name="reply" string="Reply">
                        <field name="reply_body" nolabel="1" placeholder="Write a reply and press Send Reply..."/>
                    </group>
                    <div>
                        <button name="action_send_reply" type="object" string="Send Reply" class="btn-primary"/>
                    </div>
                    <separator string="Thread"/>
                    <field name="message_ids" readonly="1" nolabel="1">
                        <tree create="0" edit="0" delete="0">
                            <field name="date_sent" widget="datetime"/>
                            <field name="direction" widget="badge"
                                   decoration-info="direction == 'in'"
                                   decoration-success="direction == 'out'"/>
                            <field name="body"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'sent'"
                                   decoration-warning="state == 'outgoing'"
                                   decoration-danger="state == 'error'"/>
                        </tree>
                    </field>
                    <group>
                        <group>
                            <field name="connection_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_message_date" readonly="1"/>
                            <field name="message_count" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_uniom_chat_search" model="ir.ui.view">
        <field name="name">uniom.chat.search</field>
        <field name="model">uniom.chat</field>
        <field name="arch" type="xml">
            <search>
                <field name="chat_id"/>
                <field name="partner_id"/>
                <field name="last_message_preview"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_connection" string="Connection" context="{'group_by': 'connection_id'}"/>
                    <filter name="group_by_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_uniom_chat" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">uniom.chat</field>
        <field name="view_mode">kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No conversations yet</p>
            <p>Every incoming and outgoing message opens a thread here — reply straight from Odoo via Uniom. Connect your account to start.</p>
        </field>
    </record>

    <!-- Messenger-style dashboard (the default Conversations experience) -->
    <record id="action_uniom_chat_dashboard" model="ir.actions.client">
        <field name="name">Conversations</field>
        <field name="tag">uniom.chat_dashboard</field>
    </record>
</odoo>
