<?xml version="1.0" encoding="utf-8" ?>
<!-- Part of Uniom Messaging Gateway for Odoo. See LICENSE file for full
     copyright and licensing details. -->
<odoo>
    <record id="view_uniom_setup_wizard_form" model="ir.ui.view">
        <field name="name">uniom.setup.wizard.form</field>
        <field name="model">uniom.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Connect Uniom Account">
                <div class="mb-3">
                    <h3>Connect your Uniom account</h3>
                    <p class="text-muted">
                        Create an API key in your Uniom dashboard (Account → API Keys)
                        and paste it below — one key per messenger account
                        (Bale, Rubika, Eitaa, Soroush+, Telegram).
                    </p>
                </div>
                <group>
                    <field name="api_key" password="True"/>
                    <field name="name"/>
                    <field name="base_url" groups="uniom_connector.group_uniom_manager"/>
                    <field name="platform" widget="selection"/>
                    <field name="inbound_mode" widget="radio"/>
                    <field name="base_url_is_public" invisible="1"/>
                </group>
                <div class="alert alert-warning" role="alert" invisible="base_url_is_public or inbound_mode != 'webhook'">
                    Your Odoo URL is not publicly reachable, so the gateway cannot push messages to it. Polling is recommended here.
                </div>
                <footer>
                    <button name="action_connect" string="Connect" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_uniom_setup_wizard" model="ir.actions.act_window">
        <field name="name">Connect Uniom Account</field>
        <field name="res_model">uniom.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
